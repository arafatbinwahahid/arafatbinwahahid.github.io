{
  "title": "data/global/footer.json",
  "type": "object",
  "required": [
    "about",
    "columns",
    "contactTitle",
    "copyright",
    "bottomLinks"
  ],
  "properties": {
    "about": {
      "type": "string"
    },
    "showSocial": {
      "type": "boolean"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "links"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "common#/$defs/link"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contactTitle": {
      "type": "string"
    },
    "copyright": {
      "type": "string"
    },
    "bottomLinks": {
      "type": "array",
      "items": {
        "$ref": "common#/$defs/link"
      }
    },
    "newsletter": {
      "type": "object"
    },
    "paymentMethods": {
      "type": "object",
      "description": "Moving row of payment logos with a \"+200 more\" button, above the copyright line",
      "properties": {
        "show": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "description": "Read by screen readers"
        },
        "logos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "image": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "more": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string",
              "pattern": "^(/|https?://)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
