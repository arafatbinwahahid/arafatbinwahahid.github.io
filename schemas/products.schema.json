{
  "title": "data/collections/products.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "slug",
      "title",
      "category",
      "images",
      "summary",
      "about",
      "description",
      "features",
      "format"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Lowercase letters, numbers and dashes only, used in the page address"
      },
      "title": {
        "$ref": "common#/$defs/text"
      },
      "category": {
        "$ref": "common#/$defs/text"
      },
      "seo": {
        "$ref": "common#/$defs/seo"
      },
      "prices": {
        "$ref": "common#/$defs/prices"
      },
      "compareAtPrices": {
        "$ref": "common#/$defs/prices"
      },
      "stock": {
        "type": "integer",
        "minimum": 0
      },
      "variants": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "prices",
            "stock"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "name": {
              "$ref": "common#/$defs/text"
            },
            "prices": {
              "$ref": "common#/$defs/prices"
            },
            "compareAtPrices": {
              "$ref": "common#/$defs/prices"
            },
            "stock": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "images": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "common#/$defs/image"
        }
      },
      "summary": {
        "$ref": "common#/$defs/text"
      },
      "about": {
        "$ref": "common#/$defs/text"
      },
      "description": {
        "type": "array",
        "items": {
          "$ref": "common#/$defs/text"
        }
      },
      "usageTitle": {
        "$ref": "common#/$defs/text"
      },
      "usageIntro": {
        "$ref": "common#/$defs/text"
      },
      "usage": {
        "type": "array",
        "items": {
          "$ref": "common#/$defs/text"
        }
      },
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "icon": {
              "type": "string"
            },
            "text": {
              "$ref": "common#/$defs/text"
            }
          },
          "additionalProperties": false
        }
      },
      "format": {
        "$ref": "common#/$defs/text"
      },
      "faq": {
        "$ref": "common#/$defs/faq"
      },
      "reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "text"
          ],
          "properties": {
            "name": {
              "$ref": "common#/$defs/text"
            },
            "rating": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "text": {
              "$ref": "common#/$defs/text"
            },
            "date": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "link": {
              "$ref": "common#/$defs/link"
            },
            "avatar": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "externalLink": {
        "$ref": "common#/$defs/link"
      },
      "status": {
        "enum": [
          "",
          "draft"
        ],
        "description": "draft = hidden from the site"
      },
      "paymentsOff": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "description": "Payment method ids (payments.json) not offered for this item"
      },
      "brand": {
        "type": "string"
      },
      "sku": {
        "type": "string"
      },
      "deliveryTime": {
        "type": "string"
      },
      "warranty": {
        "type": "string"
      },
      "badge": {
        "type": "string"
      },
      "featured": {
        "type": "boolean"
      },
      "highlights": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "videoUrl": {
        "type": "string"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rating": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "variants"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "prices"
              ]
            },
            {
              "required": [
                "stock"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "prices",
          "stock"
        ],
        "not": {
          "required": [
            "variants"
          ]
        }
      }
    ]
  }
}
