{
  "title": "data/collections/blog/*.json",
  "type": "object",
  "required": ["slug", "title", "date", "author", "category", "excerpt", "content"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "$ref": "common#/$defs/text" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "YYYY-MM-DD" },
    "author": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "excerpt": { "$ref": "common#/$defs/text" },
    "seo": { "$ref": "common#/$defs/seo" },
    "image": { "$ref": "common#/$defs/image" },
    "draft": { "type": "boolean" },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["p", "h2", "h3", "quote", "list", "image"] },
          "text": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } },
          "ordered": { "type": "boolean" },
          "src": { "$ref": "common#/$defs/imagePath" },
          "alt": { "type": "string" },
          "caption": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
