{
  "title": "data/global/site.json",
  "type": "object",
  "required": ["name", "title", "titleSeparator", "description", "url", "language", "locale", "currency", "defaultImage", "favicon", "homeLabel", "web3formsAccessKey", "theme", "person", "robots"],
  "properties": {
    "url": { "type": "string", "pattern": "^https://[^/]+$", "description": "No slash at the end, e.g. https://arafatbin.com" },
    "googleAnalyticsId": { "type": "string", "pattern": "^$|^G-[A-Z0-9]+$" },
    "verification": {
      "type": "object",
      "description": "Codes from Google Search Console, Bing Webmaster Tools, Yandex, Pinterest, Facebook and Baidu (HTML meta tag method). The code alone or the whole <meta> tag both work.",
      "properties": { "google": { "type": "string" }, "bing": { "type": "string" }, "yandex": { "type": "string" }, "pinterest": { "type": "string" }, "facebook": { "type": "string" }, "baidu": { "type": "string" } },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "description": "Defaults for every page",
      "properties": {
        "author": { "type": "string" },
        "twitterSite": { "type": "string", "description": "@username of the site on X (Twitter)" },
        "twitterCreator": { "type": "string" },
        "facebookAppId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "web3formsAccessKey": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "defaultImage": { "$ref": "common#/$defs/imagePath" },
    "favicon": { "$ref": "common#/$defs/imagePath" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "theme": {
      "type": "object",
      "required": ["primary", "accent", "dark", "text", "muted", "background", "soft", "border", "radius"],
      "additionalProperties": { "type": "string" }
    },
    "robots": { "type": "object", "required": ["allow", "disallow"], "properties": { "allow": { "type": "array", "items": { "type": "string" } }, "disallow": { "type": "array", "items": { "type": "string" } } } }
  }
}
