// Cloudflare settings. The site is a Worker with static files: the pages in dist/client/ are served directly (free,
// no limit), only /api/ (order tracking) runs code. "npm run build" makes dist/, Cloudflare then runs "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arafatbin",
  "compatibility_date": "2026-10-01",
  "assets": { "not_found_handling": "404-page" },
  // Order tracking database. No id needed: Cloudflare creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "arafatbin-orders" }],
  // Tries per visitor per minute on the order APIs (stops guessing and spam)
  "ratelimits": [
    { "name": "ORDER_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRACK_LIMIT", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
