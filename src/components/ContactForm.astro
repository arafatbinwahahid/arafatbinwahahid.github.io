---
import Icon from './Icon.astro';
import { contact } from '../lib/data';
interface Props { form: { title: string; text: string; submitLabel: string; whatsappLabel: string; success: string; note: string } }
const { form } = Astro.props;
---
<div class="card formcard rv">
  <h3>{form.title}</h3>
  <p>{form.text}</p>
  <form data-form="contact" data-success={form.success} data-wa={contact.whatsapp}>
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />
    <label for="fn">Your name</label>
    <input id="fn" name="name" autocomplete="name" required placeholder="Your name" />
    <label for="fe">Your email</label>
    <input id="fe" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
    <label for="fm">Message</label>
    <textarea id="fm" name="message" required placeholder="Tell me what you need"></textarea>
    <div class="btns">
      <button class="btn primary" type="submit"><Icon name="mail" />{form.submitLabel}</button>
      <button class="btn line" type="button" data-send-wa><Icon name="wa" />{form.whatsappLabel}</button>
    </div>
    <p class="status" role="status" aria-live="polite"></p>
    <p class="note">{form.note}</p>
  </form>
</div>
