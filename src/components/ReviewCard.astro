---
import Icon from './Icon.astro';
interface Props { review: { name: string; role?: string; date?: string; rating?: number; text: string; link?: { label: string; href: string } } }
const { review: r } = Astro.props;
const stars = Math.max(0, Math.min(5, Math.round(r.rating ?? 0)));
---
<figure class="card quote rv">
  {stars > 0 && <div class="rstars" role="img" aria-label={`${stars} out of 5 stars`}>{'★'.repeat(stars)}{'☆'.repeat(5 - stars)}</div>}
  <blockquote>{r.text}</blockquote>
  <figcaption><b>{r.name}</b>{(r.role || r.date) && <span>{[r.role, r.date].filter(Boolean).join(', ')}</span>}</figcaption>
  {r.link && <a class="btn line" href={r.link.href} target="_blank" rel="noopener"><Icon name="in" />{r.link.label}</a>}
</figure>
