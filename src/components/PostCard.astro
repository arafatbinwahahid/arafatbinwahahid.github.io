---
import { formatDate, type Post } from '../lib/data';
interface Props { post: Post; readMore?: string }
const { post, readMore = 'Read more' } = Astro.props;
---
<a class="card postcard rv" href={`/blog/${post.slug}`}>
  {post.image && <img src={post.image.src} alt={post.image.alt} loading="lazy" />}
  <div class="pbody">
    <p class="cat">{post.category} &middot; <time datetime={post.date}>{formatDate(post.date)}</time></p>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <span class="more">{readMore} &rarr;</span>
  </div>
</a>
