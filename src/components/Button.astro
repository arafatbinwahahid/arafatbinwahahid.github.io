---
import Icon from './Icon.astro';
import { isExternal } from '../lib/data';

export interface ButtonData { label: string; href: string; style?: string; icon?: string; download?: boolean }
interface Props extends ButtonData {}
const { label, href, style = 'primary', icon, download } = Astro.props;
const external = isExternal(href);
---
<a
  class={`btn ${style}`}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  download={download ? '' : undefined}
>{icon && <Icon name={icon} />}{label}</a>
