---
interface Props { title: string; subtitle?: string; eyebrow?: string }
const { title, subtitle, eyebrow } = Astro.props;
---
<section class="phero">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="lead">{subtitle}</p>}
    <slot />
  </div>
</section>
