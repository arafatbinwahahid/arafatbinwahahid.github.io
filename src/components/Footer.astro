---
import Icon from './Icon.astro';
import { site, navigation, social } from '../lib/data';
---
<footer>
  <div class="wrap fgrid">
    <div class="fbrand">
      <a class="brand" href="/">{site.name}</a>
      <p>{site.footerText}</p>
      <div class="soc">
        {social.map((s) => <a href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={s.label}><Icon name={s.icon} /></a>)}
      </div>
    </div>
    {navigation.footer.map((col) => (
      <nav class="fcol" aria-label={col.title}>
        <p class="ft">{col.title}</p>
        {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
  </div>
  <div class="wrap fbottom">
    <span>&copy; {new Date().getFullYear()} {site.copyright}</span>
    <a class="totop" href="#top"><Icon name="up" />Back to top</a>
  </div>
</footer>
