---
import { formatPrice } from '../lib/data';
interface Props { product: { slug: string; title: string; category: string; price: number; salePrice: number | null; image: { src: string; alt: string }; summary: string; inStock: boolean } }
const { product: p } = Astro.props;
---
<a class="card pcard rv" href={`/shop/${p.slug}`}>
  <div class="pimg">
    <img src={p.image.src} alt={p.image.alt} loading="lazy" />
    {p.salePrice != null && <span class="badge">Sale</span>}
    {!p.inStock && <span class="badge out">Sold out</span>}
  </div>
  <div class="pbody">
    <p class="cat">{p.category}</p>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    <p class="price">
      {p.salePrice != null ? <><b>{formatPrice(p.salePrice)}</b> <s>{formatPrice(p.price)}</s></> : <b>{formatPrice(p.price)}</b>}
    </p>
  </div>
</a>
