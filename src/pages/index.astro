---
import BaseLayout from '../layouts/BaseLayout.astro';
import Buttons from '../components/Buttons.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import PostCard from '../components/PostCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Zoom from '../components/Zoom.astro';
import page from '../data/pages/home.json';
import work from '../data/pages/work.json';
import reviews from '../data/pages/reviews.json';
import blog from '../data/pages/blog.json';
import { featuredServices, featuredProducts, posts } from '../lib/data';

const { hero, stats, marquee, sections: s, cta } = page;
---
<BaseLayout title={page.seo.title || undefined} description={page.seo.description}>
  <section class="hero" aria-label="Introduction">
    <div class="bokeh" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div>
    <div class="wrap">
      <div class="lcd" aria-hidden="true" data-words={JSON.stringify(hero.lcdWords)}><span id="lcdText">{hero.lcdWords[0]}</span><span class="cur"></span></div>
      <h1><span>{hero.titleLine1}</span><span>{hero.titleLine2}</span></h1>
      <p class="lead">{hero.lead}</p>
      <Buttons items={hero.buttons} />
    </div>
  </section>

  {stats.length > 0 && (
    <section class="statsec">
      <div class="wrap stats">
        {stats.map((st) => <div class="stat rv"><b><span data-count={st.value}>{st.value}</span>{st.suffix}</b><span>{st.label}</span></div>)}
      </div>
    </section>
  )}

  {marquee.length > 0 && (
    <div class="strip" aria-hidden="true"><div>{[...marquee, ...marquee].map((m) => <span>{m}</span>)}</div></div>
  )}

  {s.services.show && (
    <section>
      <div class="wrap">
        <SectionHead title={s.services.title} intro={s.services.intro} link={{ label: s.services.linkLabel, href: '/services' }} />
        <div class="grid3">{featuredServices.slice(0, s.services.limit).map((x) => <ServiceCard service={x} />)}</div>
      </div>
    </section>
  )}

  {s.work.show && (
    <section class="alt">
      <div class="wrap">
        <SectionHead title={s.work.title} link={{ label: s.work.linkLabel, href: '/work' }} />
        <div class="grid2">
          {work.projects.slice(0, s.work.limit).map((p) => (
            <article class="card wcard rv">
              <Zoom src={p.image.src} alt={p.image.alt} caption={p.image.caption} class="fimg" />
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {s.shop.show && featuredProducts.length > 0 && (
    <section>
      <div class="wrap">
        <SectionHead title={s.shop.title} intro={s.shop.intro} link={{ label: s.shop.linkLabel, href: '/shop' }} />
        <div class="grid3">{featuredProducts.slice(0, s.shop.limit).map((p) => <ProductCard product={p} />)}</div>
      </div>
    </section>
  )}

  {s.reviews.show && reviews.items.length > 0 && (
    <section class="alt">
      <div class="wrap">
        <SectionHead title={s.reviews.title} link={{ label: s.reviews.linkLabel, href: '/reviews' }} />
        <div class="grid3">{reviews.items.slice(0, s.reviews.limit).map((r) => <ReviewCard review={r} />)}</div>
      </div>
    </section>
  )}

  {s.blog.show && posts.length > 0 && (
    <section>
      <div class="wrap">
        <SectionHead title={s.blog.title} link={{ label: s.blog.linkLabel, href: '/blog' }} />
        <div class="grid3">{posts.slice(0, s.blog.limit).map((p) => <PostCard post={p} readMore={blog.readMoreLabel} />)}</div>
      </div>
    </section>
  )}

  <section class="ctasec">
    <div class="wrap ctabox rv">
      <h2>{cta.title}</h2>
      <p>{cta.text}</p>
      <Buttons items={cta.buttons} />
    </div>
  </section>
</BaseLayout>
