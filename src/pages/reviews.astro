---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ReviewForm from '../components/ReviewForm.astro';
import Icon from '../components/Icon.astro';
import page from '../data/pages/reviews.json';
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHero title={page.hero.title} subtitle={page.hero.subtitle} />
  <section>
    <div class="wrap">
      <div class="grid3">
        {page.items.map((r) => <ReviewCard review={r} />)}
        {page.fiverr && (
          <div class="card fiv rv">
            <h3>{page.fiverr.title}</h3>
            <p>{page.fiverr.text}</p>
            <a class="btn primary" href={page.fiverr.button.href} target="_blank" rel="noopener"><Icon name="globe" />{page.fiverr.button.label}</a>
          </div>
        )}
      </div>
      {page.form.show && <div class="narrow"><ReviewForm form={page.form} /></div>}
    </div>
  </section>
</BaseLayout>
