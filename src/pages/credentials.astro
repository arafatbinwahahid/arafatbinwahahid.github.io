---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import page from '../data/pages/credentials.json';
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHero title={page.hero.title} subtitle={page.hero.subtitle} />
  <section>
    <div class="wrap">
      <div class="certs">
        {page.certificates.map((c) => (
          <button class="cert card rv" data-zoom={c.image} data-cap={c.caption}>
            <div class="im"><img src={c.image} alt={c.alt} loading="lazy" /></div>
            <div class="tx"><b>{c.title}</b><span>{c.detail}</span></div>
          </button>
        ))}
      </div>
      <h2 class="rv">{page.educationTitle}</h2>
      <div class="grid2">
        {page.education.map((e) => <div class="card rv"><h3>{e.title}</h3><p>{e.detail}</p></div>)}
      </div>
    </div>
  </section>
</BaseLayout>
