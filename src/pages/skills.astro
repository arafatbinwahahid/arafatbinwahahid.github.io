---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import page from '../data/pages/skills.json';
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHero title={page.hero.title} subtitle={page.hero.subtitle} />
  <section>
    <div class="wrap">
      <div class="skillgrid">
        {page.groups.map((g) => (
          <div class="rv"><h3>{g.title}</h3><div class="tags">{g.items.map((i) => <span>{i}</span>)}</div></div>
        ))}
      </div>
      {page.languages && (
        <>
          <h2 class="rv">{page.languages.title}</h2>
          <div class="langs">{page.languages.items.map((l) => <div class="card rv"><b>{l.name}</b><span class="mute">{l.level}</span></div>)}</div>
        </>
      )}
    </div>
  </section>
</BaseLayout>
