---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import page from '../data/pages/contact.json';
import { site, contact, social } from '../lib/data';
const links = social.filter((s) => s.icon !== 'pin' && s.icon !== 'mail');
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHero title={page.hero.title} subtitle={page.hero.subtitle} />
  <section>
    <div class="wrap contact">
      <ul class="clist rv">
        {contact.phones.map((p) => <li><a href={`tel:${p.number}`}><Icon name="phone" /><span><small>{p.label}</small><b>{p.display}</b></span></a></li>)}
        <li><a href={`mailto:${contact.email}`}><Icon name="mail" /><span><small>Email</small><b>{contact.email}</b></span></a></li>
        {links.map((s) => <li><a href={s.url} target="_blank" rel="noopener"><Icon name={s.icon} /><span><small>{s.label}</small><b>{s.display}</b></span></a></li>)}
        {page.showCvLink && <li><a href={site.cvFile} download><Icon name="dl" /><span><small>Curriculum vitae, PDF</small><b>Download my CV</b></span></a></li>}
        <li><a href={contact.mapUrl} target="_blank" rel="noopener"><Icon name="pin" /><span><small>Address, open in Maps</small><b>{contact.address}</b></span></a></li>
      </ul>
      <div>
        <ContactForm form={page.form} />
        <p class="coords">GPS {contact.gps}</p>
      </div>
    </div>
  </section>
</BaseLayout>
