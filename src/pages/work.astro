---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Buttons from '../components/Buttons.astro';
import Zoom from '../components/Zoom.astro';
import page from '../data/pages/work.json';
---
<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHero title={page.hero.title} subtitle={page.hero.subtitle} />
  <section>
    <div class="wrap">
      {page.projects.map((p) => (
        <article class="feature rv">
          <Zoom src={p.image.src} alt={p.image.alt} caption={p.image.caption} width={p.image.width} height={p.image.height} class="fimg" />
          <div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
            <Buttons items={p.buttons} />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
